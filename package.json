{
  "name": "ctrl",
  "version": "0.21.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs && vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper || true; node scripts/brand-electron.mjs",
    "icon": "node scripts/icon.mjs",
    "brand": "node scripts/brand-electron.mjs",
    "package": "node scripts/package.mjs",
    "install-app": "node scripts/package.mjs --install",
    "release": "node scripts/release.mjs",
    "cli-docs": "node scripts/build.mjs && node dist/cli/cli.cjs docs > docs/CLI-REFERENCE.md"
  },
  "dependencies": {
    "@xterm/addon-unicode-graphemes": "^0.4.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@opencode/client": "^2.0.25",
    "@opencode/plugin": "^2.0.25",
    "@resvg/resvg-js": "^2.6.2",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "markdown-it": "^15.0.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "ws": "^8.22.0"
  },
  "productName": "ctrl",
  "build": {
    "appId": "im.luc.ctrl",
    "productName": "ctrl",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "!dist/**/*.map",
      "!dist/bridge/**",
      "!dist/cli/**",
      "!dist/companion/**",
      "package.json",
      "!node_modules/node-pty/prebuilds/win32-*/**"
    ],
    "extraResources": [
      {
        "from": "dist/bridge",
        "to": "bridge"
      },
      {
        "from": "skills",
        "to": "skills"
      },
      {
        "from": "dist/cli",
        "to": "cli"
      },
      {
        "from": "dist/companion",
        "to": "companion"
      }
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "mac": {
      "target": "dir",
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "ctrl runs your coding agents, which read and edit files in the folders you work in.",
        "NSDesktopFolderUsageDescription": "ctrl runs your coding agents, which read and edit files in the folders you work in.",
        "NSDownloadsFolderUsageDescription": "ctrl runs your coding agents, which read and edit files in the folders you work in.",
        "NSNetworkVolumesUsageDescription": "ctrl runs your coding agents, which read and edit files in the folders you work in.",
        "NSRemovableVolumesUsageDescription": "ctrl runs your coding agents, which read and edit files in the folders you work in.",
        "NSAppleEventsUsageDescription": "ctrl's companion reads the address of the tab you're looking at to show the sessions that mentioned it."
      }
    },
    "electronLanguages": [
      "en"
    ]
  }
}
